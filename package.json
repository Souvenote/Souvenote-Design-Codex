{
  "name": "souvenote",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": "10.9.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build --workspace=@souvenote/contracts",
    "dev": "node scripts/dev.mjs",
    "dev:setup": "node scripts/dev.mjs --migrate",
    "dev:setup:isolated": "node scripts/dev.mjs --migrate --isolated",
    "dev:web": "npm run dev --workspace=@souvenote/web",
    "dev:api": "npm run dev --workspace=@souvenote/api",
    "dev:worker": "npm run dev --workspace=@souvenote/worker",
    "dev:down": "docker compose down --remove-orphans",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down --remove-orphans",
    "db:logs": "docker compose logs postgres",
    "db:migrate": "node database/migrate.mjs",
    "db:migrate:check": "node database/migrate.mjs --check",
    "test:database": "node database/verify.mjs",
    "health": "node scripts/healthcheck.mjs",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "smoke:stack": "node scripts/dev.mjs --smoke",
    "smoke:stack:isolated": "node scripts/dev.mjs --smoke --isolated",
    "toolchain": "node scripts/check-toolchain.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"scripts/**/*.mjs\" \"*.config.mjs\" --max-warnings=0 && npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:scripts": "node --test scripts/lib/local-runtime.test.mjs scripts/lib/health.test.mjs scripts/lib/toolchain.test.mjs scripts/lib/governance.test.mjs scripts/lib/repository-policy.test.mjs scripts/lib/contracts-policy.test.mjs",
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run toolchain && npm run contracts:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:prod"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.1",
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^2": "2.1.4",
    "brace-expansion@^5": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "undici": "6.28.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "eslint-config-prettier": "10.1.8",
    "fast-uri": "3.1.6",
    "globals": "17.7.0",
    "openapi-typescript": "6.7.6",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}

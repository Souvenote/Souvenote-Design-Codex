# Server-only Souvenote BFF configuration. Never prefix these values with NEXT_PUBLIC_.
AUTH_MODE=local
API_INTERNAL_BASE_URL=http://127.0.0.1:4000/api/v1
BFF_SESSION_SECRET=replace-with-at-least-32-random-characters

# Credential-free local/test principal. AUTH_MODE=local is rejected in production.
LOCAL_AUTH_SECRET=replace-with-at-least-32-random-characters
LOCAL_AUTH_CLIENT_ID=souvenote-local-web
LOCAL_AUTH_SUBJECT=00000000-0000-4000-8000-000000000001
LOCAL_AUTH_EMAIL=local@souvenote.invalid
LOCAL_AUTH_SCOPE=souvenote:customer

# Production Cognito authorization-code/PKCE configuration.
COGNITO_DOMAIN=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_REDIRECT_URI=
COGNITO_LOGOUT_URI=
COGNITO_OAUTH_SCOPES=openid email profile souvenote:customer

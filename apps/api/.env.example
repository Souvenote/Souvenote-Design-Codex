NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/souvenote_dev
DATABASE_SSL_MODE=disable
# Production requires verify-full and a base64-encoded PEM CA bundle.
DATABASE_SSL_CA_BASE64=
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_READINESS_TIMEOUT_MS=2000
TRUST_PROXY_HOPS=0
API_JSON_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_WINDOW_MS=60000

AI_MOCK_MODE=true
PAYMENT_PROVIDER_MODE=mock
FULFILLMENT_PROVIDER_MODE=mock
# Local/test contract simulator only; production remains database-feature-flagged off.
BLANK_CARD_HANDOFF_ENABLED=true

# Cognito is the default when AUTH_MODE is omitted. Local mode accepts only
# short-lived HMAC-signed development tokens and is rejected outside dev/test.
AUTH_MODE=local
LOCAL_AUTH_SECRET=replace-with-at-least-32-random-characters
LOCAL_AUTH_CLIENT_ID=souvenote-local-web
COGNITO_REQUIRED_SCOPES=souvenote:customer
AUTH_CLOCK_SKEW_SECONDS=60
COGNITO_JWKS_CACHE_MS=3600000
COGNITO_JWKS_FETCH_TIMEOUT_MS=2000
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=
AWS_S3_BUCKET_NAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SCRIBELESS_WEBHOOK_SECRET=

POSTHOG_API_KEY=
SENTRY_DSN=
SENDGRID_API_KEY=
SCRIBELESS_API_KEY=

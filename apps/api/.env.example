NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/souvenote_dev
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_READINESS_TIMEOUT_MS=2000

AI_MOCK_MODE=true

# Cognito is the default when AUTH_MODE is omitted. Disabled mode is local/test
# only: it rejects authenticated requests and never creates a fake identity.
AUTH_MODE=disabled
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=
AWS_S3_BUCKET_NAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

POSTHOG_API_KEY=
SENTRY_DSN=
SENDGRID_API_KEY=
SCRIBELESS_API_KEY=
